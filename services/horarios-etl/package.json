{
	"name": "horarios-etl",
	"version": "0.1.0",
	"private": true,
	"description": "Worker ETL de horas extras de la app de Horarios (Hono + Node). Ver src/apps/horarios/results/ETL_HORAS_EXTRAS.md",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "node --watch src/server.ts",
		"start": "node src/server.ts",
		"typecheck": "tsc --noEmit",
		"etl": "node --env-file-if-exists=.env src/jobs/cli.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@directus/sdk": "^20.3.0",
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "~5.9.3",
		"vitest": "^2.1.9"
	}
}
