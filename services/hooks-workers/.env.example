# Server & Runtime Environment
# - PORT: Port where Hono listens (default: 3020)
# - NODE_ENV: 'development' (pretty logs) | 'production' (JSON logs)
# - LOG_LEVEL: 'debug' | 'info' | 'warn' | 'error'
PORT=3020
NODE_ENV=development
LOG_LEVEL=info

# Webhook Authentication Token
# Required shared secret token sent by Directus in Authorization: Bearer <token> or x-hook-token
STATIC_HOOK_TOKEN=your_secure_static_token_here

# Directus CMS Integration
# - DIRECTUS_URL: Directus instance base URL
# - DIRECTUS_SERVICE_TOKEN: Static service / admin token for Directus SDK client
DIRECTUS_URL=https://directus.kancan.knovalab.com
DIRECTUS_SERVICE_TOKEN=your_directus_service_token_here
