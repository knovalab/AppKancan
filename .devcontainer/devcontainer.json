{
	"name": "AppKancan",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	// Levanta también el worker ETL (services/horarios-etl). Su puerto 3010 se publica desde
	// docker-compose.yml; desde el contenedor `app` se llega con http://etl:3010.
	"runServices": ["app", "etl"],
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {
			"version": "os-provided"
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "22"
		}
	},
	"postStartCommand": "npm install",
	"customizations": {
		"vscode": {
			"extensions": ["biomejs.biome"],
			"settings": {
				"editor.formatOnSave": true,
				"[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
				"[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
				"[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
				"[json]": { "editor.defaultFormatter": "biomejs.biome" },
				"window.titleBarStyle": "custom",
				"editor.codeActionsOnSave": {
					"source.organizeImports.biome": "explicit"
				}
			}
		}
	},
	// Comando ejecutado la primera vez que se crea el contenedor
	"remoteUser": "root",
	"updateRemoteUserUID": true
}
